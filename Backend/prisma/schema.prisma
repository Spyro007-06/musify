datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  USER
  ARTIST
  ADMIN
  SUPERADMIN
}

model User {
  id           String    @id @default(uuid())
  supabaseId   String    @unique // links to auth.users.id in Supabase
  email        String    @unique
  username     String    @unique
  displayName  String?
  avatarUrl    String?
  bio          String?
  role         Role      @default(USER)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  playlists     Playlist[]
  likedTracks   LikedTrack[]
  likedAlbums   LikedAlbum[]
  dislikedSongs DislikedSong[]

  listeningHistory ListeningHistory[]
  skippedSongs     SkippedSongs[]
  moodHistory      MoodHistory[]

  userPreferences UserPreferences?
  genreAffinity   GenreAffinity[]
  artistAffinity  ArtistAffinity[]

  recommendationScores RecommendationScores[]
  recommendationCache  RecommendationCache[]
  searchHistory        SearchHistory[]
}

model Playlist {
  id          String          @id @default(uuid())
  title       String
  slug        String
  description String?
  coverUrl    String?
  isPublic    Boolean         @default(true)
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String   @map("spotifyTrackId") // catalog (Saavn) song id
  position   Int      @default(0) // 0-based order within the playlist
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model LikedTrack {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @map("spotifyTrackId") // catalog (Saavn) song id
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
}

model LikedAlbum {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumId   String
  createdAt DateTime @default(now())

  @@unique([userId, albumId])
  @@index([userId])
}

model DislikedSong {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @map("spotifyTrackId") // catalog (Saavn) song id
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId])
}

// ---------------------------------------------------------
// NEW RECOMMENDATION ENGINE MODELS
// ---------------------------------------------------------

model ListeningHistory {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId  String  @map("spotifyTrackId") // catalog (Saavn) song id
  albumId  String?
  artistId String?
  genre    String?

  timestamp        DateTime @default(now())
  device           String?
  sessionDuration  Int? // in seconds
  listenPercentage Float? // e.g. 0 to 100
  completedSong    Boolean  @default(false)
  numberOfReplays  Int      @default(0)

  @@index([userId, timestamp])
  @@index([trackId])
}

model SkippedSongs {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @map("spotifyTrackId") // catalog (Saavn) song id
  skipTime  Float // in seconds when the song was skipped
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model MoodHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood       String // e.g. "chill", "workout", "focus"
  isImplicit Boolean  @default(false) // true if auto-detected, false if selected by user
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
}

model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favouriteLanguages String[]
  favouriteAlbums    String[]
  favouriteArtists   String[]
  favouriteGenres    String[]
  favouriteMoods     String[]
  updatedAt          DateTime @updatedAt
}

model GenreAffinity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre     String
  score     Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, genre])
  @@index([userId, score(sort: Desc)])
}

model ArtistAffinity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId   String   @map("spotifyArtistId") // catalog (Saavn) artist id
  score      Float    @default(1.0)
  isFollowed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, artistId])
  @@index([userId, score(sort: Desc)])
}

// ---------------------------------------------------------
// CACHING & SEARCH
// ---------------------------------------------------------

model RecommendationScores {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @map("spotifyTrackId") // catalog (Saavn) song id
  score     Float
  reason    String?
  updatedAt DateTime @updatedAt

  @@unique([userId, trackId])
  @@index([userId])
  @@index([score])
}

model RecommendationCache {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionType String // e.g., "continue-listening", "recently-played", etc.
  cachedData  Json // stores array of tracks, albums or artists
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, sectionType])
  @@index([userId, sectionType])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
