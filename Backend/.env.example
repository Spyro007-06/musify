# =============================================================================
# VIBE BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=Vibe
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# Get these from your Supabase project: Settings → API
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No SUPABASE_JWT_SECRET: auth.ts verifies Bearer tokens via
# supabase.auth.getClaims(), which checks the project's JWKS endpoint
# (works whether the project signs tokens asymmetrically or with a legacy
# shared secret) instead of a hardcoded secret. Remove this var from
# Railway once nothing else reads it — as of this commit only test
# fixtures set it, for an arbitrary (never verified) signing key.

# Supabase also provides a direct PostgreSQL connection URL for Prisma.
# connection_limit=10 assumes ONE running app instance against this
# project's current tier (Postgres max_connections=60, checked directly
# via `SHOW max_connections`). It must be reviewed — and likely lowered
# per instance — before running multiple instances or scaling up, or the
# app alone can exhaust the database's connection ceiling. Without this
# param, Prisma auto-sizes its pool from the *running process's* CPU
# count, which is non-deterministic and not something anyone chose.
DATABASE_URL=postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?connection_limit=10

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
#
# REQUIRED for any production-like deployment. If unset, the code falls
# back to 'super-secret-csrf-key-for-dev-only' (src/config/env.ts) — a
# fixed, publicly-visible-in-source string. Running production with that
# default active means CSRF tokens are forgeable by anyone who's read this
# repo. Generate a real one, e.g. `openssl rand -hex 32`.
# ─────────────────────────────────────────────────────────────────────────────
CSRF_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─────────────────────────────────────────────────────────────────────────────
# SWAGGER
# ─────────────────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# PAGINATION
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDATION ENGINE
#
# Optional — read directly via process.env in src/jobs/recommendationCron.ts
# (not through config/env.ts's validated schema). Defaults to every 6 hours
# ('0 */6 * * *') if unset. Standard cron syntax.
# ─────────────────────────────────────────────────────────────────────────────
RECOMMENDATION_CRON_SCHEDULE=

# ─────────────────────────────────────────────────────────────────────────────
# ERROR TRACKING
#
# REQUIRED for any production-like deployment. With SENTRY_DSN unset, the
# app still runs fine, but every uncaught exception, unhandled rejection,
# and errorHandler-caught error is visible ONLY in local log files
# (src/utils/logger.ts) — nothing is aggregated, alerted on, or searchable.
# The server logs a startup warning if it boots with NODE_ENV=production
# and no DSN set, precisely so this can't silently regress to "off" again.
#
# Get a DSN: create (or reuse) a project at https://sentry.io -> Settings
# -> Projects -> <project> -> Client Keys (DSN). Use a separate DSN per
# environment (dev/staging/prod) if you want them to show up as separate
# Sentry projects rather than mixed together.
#
# Safe to leave unset for local development.
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# AI LYRICS ANALYSIS
#
# REQUIRED for POST /api/ai/lyrics/analyze to work. Without it,
# AIService.analyzeLyrics throws ClaudeUpstreamError (mapped to a clean 503
# "Lyrics analysis is temporarily unavailable") rather than returning a
# fake/hardcoded result — there is no mock fallback.
#
# Get a key: https://console.anthropic.com/settings/keys. Uses
# claude-haiku-4-5-20251001 (an extraction/classification task, not one
# needing a frontier model), wrapped in the same resilientCall
# timeout/retry/circuit-breaker discipline as the JioSaavn dependency (see
# src/utils/resilience.ts), on its own breaker ("claude-lyrics-analysis")
# isolated from every other breaker in the system.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
